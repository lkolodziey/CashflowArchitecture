{
  "Gateway": {
    "ApiKey": "local-dev-api-key"
  },
  "ReverseProxy": {
    "Routes": {
      "ledger": {
        "ClusterId": "ledger",
        "Match": {
          "Path": "/transactions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/transactions/{**catch-all}"
          }
        ]
      },
      "balances": {
        "ClusterId": "consolidation",
        "Match": {
          "Path": "/daily-balances/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/daily-balances/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "ledger": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "consolidation": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
